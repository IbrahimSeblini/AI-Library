# Backend environment variables
# Copy to .env and fill in your values.

# --- Gemini: choose ONE of the two options below ---

# Option A: Vertex AI Gemini (GCP billing / quotas; recommended for production)
# Requires: Vertex AI API enabled, Application Default Credentials (gcloud auth application-default login or GOOGLE_APPLICATION_CREDENTIALS).
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# Option B: Gemini Developer API / AI Studio (API key; free tier limits)
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# If both are set, Vertex AI is used. If only GEMINI_API_KEY is set, Developer API is used.
