# Library Service environment variables
# Copy to .env and set your values.

# Database (optional; defaults to sqlite in library_service dir)
# DATABASE_URL=sqlite:///./library.db

# --- Gemini (PDF ingestion / structured extraction) ---
# Use either Vertex AI or Developer API (see backend/.env.example). If both set, Vertex is used.
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model and limits (default: gemini-1.5-flash for separate quota from quiz’s 2.5-flash)
# GEMINI_INGESTION_MODEL=gemini-1.5-flash
# GEMINI_INGESTION_MAX_INPUT_CHARS=120000

# Optional: ingestion limits
# INGESTION_PAGE_LIMIT=50
# INGESTION_FILE_SIZE_MB=25.0
